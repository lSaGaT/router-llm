DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── LLM Harness environment ───

# Generate with: openssl rand -hex 32
# Used to encrypt stored API keys at rest (AES-256-GCM).
# Leave empty in dev to use a deterministic fallback (NOT for production).
HARNESS_ENCRYPTION_KEY=

# Auth key the Claude Code client must send as x-api-key or Authorization: Bearer.
# Leave empty in dev to disable auth (single-tenant, local only).
HARNESS_API_KEY=
