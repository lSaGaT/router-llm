# ─── LLM Router environment ───
# Copy this file:  cp .env.example .env

# Database URL (SQLite by default)
DATABASE_URL=file:./db/custom.db

# ─── Encryption ───
# Used to encrypt stored API keys at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Leave empty in dev to use a deterministic fallback (NOT for production).
HARNESS_ENCRYPTION_KEY=

# ─── Gateway auth (optional) ───
# If set, the Claude Code client must send this as x-api-key or Authorization: Bearer.
# Leave empty in dev to disable auth (single-tenant, local only).
HARNESS_API_KEY=

# ─── Server ───
# PORT=3000
# ROUTER_UPSTREAM_TIMEOUT_MS=600000
